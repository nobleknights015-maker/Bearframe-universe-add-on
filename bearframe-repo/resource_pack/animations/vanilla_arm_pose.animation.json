{
  "format_version": "1.8.0",
  "animations": {
    "animation.bearframe.echo_civilian.arm_swing": {
      "loop": true,
      "anim_time_update": "query.modified_distance_moved",
      "bones": {
        "rightarm": {
          "rotation": [
            "math.cos(query.anim_time * 38.17) * math.clamp(query.modified_move_speed * 80, 0, 17)",
            0,
            0
          ]
        },
        "leftarm": {
          "rotation": [
            "math.cos(query.anim_time * 38.17 + 180) * math.clamp(query.modified_move_speed * 80, 0, 17)",
            0,
            0
          ]
        }
      }
    },
    "animation.bearframe.signal_officer.ready": {
      "loop": true,
      "bones": {
        "rightarm": {
          "rotation": [
            0,
            0,
            -3
          ]
        },
        "leftarm": {
          "rotation": [
            0,
            0,
            3
          ]
        }
      }
    }
  }
}
