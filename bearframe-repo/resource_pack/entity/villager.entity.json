      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/bearframe/vanilla/villager"
      },
      "geometry": {
        "default": "geometry.bearframe.vanilla_villager",
        "baby": "geometry.bearframe.vanilla_villager_baby"
      },
      "scripts": {
