{
  "format_version": "1.20.30",
  "minecraft:attachable": {
    "description": {
      "identifier": "bearframe:hush_pendulum",
      "item": {
        "bearframe:hush_pendulum": "query.is_owner_identifier_any('minecraft:player')"
      },
      "materials": {
        "default": "entity",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/bearframe/held/hush_pendulum",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.bearframe.held.hush_pendulum"
      },
      "animations": {
        "first": "animation.bearframe.held.hush_pendulum.first",
        "third": "animation.bearframe.held.hush_pendulum.third",
        "whip": "animation.bearframe.held.hush_pendulum.whip",
        "energy": "animation.bearframe.held.hush_pendulum.energy"
      },
      "scripts": {
        "animate": [
          {
            "first": "context.is_first_person == 1.0"
          },
          {
            "third": "context.is_first_person == 0.0"
          },
          "whip",
          "energy"
        ],
        "pre_animation": [
          "v.bearframe_flail_swing = c.owning_entity->v.attack_time;"
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
