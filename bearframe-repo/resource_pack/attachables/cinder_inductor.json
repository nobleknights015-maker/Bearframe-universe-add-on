{
  "format_version": "1.20.30",
  "minecraft:attachable": {
    "description": {
      "identifier": "bearframe:cinder_inductor",
      "item": {
        "bearframe:cinder_inductor": "query.is_owner_identifier_any('minecraft:player')"
      },
      "materials": {
        "default": "entity",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/bearframe/held/cinder_inductor",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.bearframe.held.cinder_inductor"
      },
      "animations": {
        "first": "animation.bearframe.held.cinder_inductor.first",
        "third": "animation.bearframe.held.cinder_inductor.third",
        "energy": "animation.bearframe.held.cinder_inductor.energy"
      },
      "scripts": {
        "animate": [
          {
            "first": "context.is_first_person == 1.0"
          },
          {
            "third": "context.is_first_person == 0.0"
          },
          "energy"
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
