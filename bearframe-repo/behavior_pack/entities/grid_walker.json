{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "bearframe:grid_walker",
      "is_spawnable": true,
      "is_summonable": true
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "ghost_grid",
          "grid_walker",
          "mob"
        ]
      },
      "minecraft:health": {
        "value": 32,
        "max": 32
      },
      "minecraft:collision_box": {
        "width": 1.15,
        "height": 0.98
      },
      "minecraft:persistent": {},
      "minecraft:physics": {},
      "minecraft:movement": {
        "value": 0.18
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "avoid_damage_blocks": true,
        "can_path_over_water": true
      },
      "minecraft:jump.static": {},
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.72,
        "xz_dist": 5,
        "y_dist": 2
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 7,
        "probability": 0.35
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:attack": {
        "damage": 5
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "speed_multiplier": 1.05,
        "track_target": true
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "alert_same_type": true
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/grid_machine.json"
      },
      "minecraft:interact": {
        "interactions": [
          {
            "interact_text": "Inspect",
            "on_interact": {
              "event": "bearframe:look",
              "target": "self"
            }
          }
        ]
      }
    },
    "events": {
      "bearframe:look": {},
      "bearframe:relay_offline": {
        "add": {
          "component_groups": [
            "bearframe:relay_waiting"
          ]
        }
      },
      "bearframe:relay_online": {
        "remove": {
          "component_groups": [
            "bearframe:relay_waiting"
          ]
        },
        "add": {
          "component_groups": [
            "bearframe:relay_active"
          ]
        }
      },
      "bearframe:switch_a": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "bearframe:relay_waiting",
                "bearframe:switch_b"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "bearframe:switch_a"
              ]
            }
          }
        ]
      },
      "bearframe:switch_b": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "bearframe:relay_waiting",
                "bearframe:switch_a"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "bearframe:switch_b"
              ]
            }
          }
        ]
      }
    },
    "component_groups": {
      "bearframe:relay_waiting": {
        "minecraft:movement": {
          "value": 0
        }
      },
      "bearframe:relay_active": {
        "minecraft:movement": {
          "value": 0.18
        }
      },
      "bearframe:switch_a": {
        "minecraft:movement": {
          "value": 0.18
        },
        "minecraft:behavior.move_to_block": {
          "priority": 4,
          "target_blocks": [
            "minecraft:birch_standing_sign"
          ],
          "search_range": 14,
          "search_height": 2,
          "goal_radius": 1.75,
          "tick_interval": 15,
          "on_reach": [
            {
              "event": "bearframe:switch_b",
              "target": "self"
            }
          ]
        }
      },
      "bearframe:switch_b": {
        "minecraft:movement": {
          "value": 0.18
        },
        "minecraft:behavior.move_to_block": {
          "priority": 4,
          "target_blocks": [
            "minecraft:spruce_standing_sign"
          ],
          "search_range": 14,
          "search_height": 2,
          "goal_radius": 1.75,
          "tick_interval": 15,
          "on_reach": [
            {
              "event": "bearframe:switch_a",
              "target": "self"
            }
          ]
        }
      }
    }
  }
}
