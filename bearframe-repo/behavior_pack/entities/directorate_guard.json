      "bearframe:hostile": {
        "minecraft:type_family": {
          "family": [
            "directorate",
            "directorate_guard",
            "mob",
            "monster"
          ]
        },
        "minecraft:attack": {
          "damage": 5
        },
        "minecraft:behavior.melee_attack": {
          "priority": 2,
          "speed_multiplier": 1.1,
          "track_target": true
        },
        "minecraft:behavior.hurt_by_target": {
          "priority": 1,
          "alert_same_type": true
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": true,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 16
            },
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "bearframe"
              },
